
//==============================================================
// ShadowMap.hlsl
// シャドウパス用シェーダー
// 光源の視点からシーンを描画して、深度値をテクスチャに書き込む。
//==============================================================

//--------------------------------------------------------------
// テクスチャ（葉っぱなど透明部分のあるモデル用）
//--------------------------------------------------------------
Texture2D    g_texture : register(t0);
SamplerState g_sampler : register(s0);

//--------------------------------------------------------------
// 定数バッファ（C++側の ShadowMap::SHADOW_CB に対応）
//--------------------------------------------------------------
cbuffer global : register(b0)
{
    float4x4 g_matWVP;   // 光源のワールド × ビュー × プロジェクション行列
};

//--------------------------------------------------------------
// 頂点シェーダー出力
//--------------------------------------------------------------
struct VS_OUT
{
    float4 pos : SV_POSITION;
    float2 uv  : TEXCOORD0;     // アルファテストに使うUV座標
};

//--------------------------------------------------------------
// 頂点シェーダー
//--------------------------------------------------------------
VS_OUT VS(float4 pos : POSITION, float4 normal : NORMAL, float2 uv : TEXCOORD)
{
    VS_OUT output;
    output.pos = mul(pos, g_matWVP);
    output.uv  = uv;
    return output;
}

//--------------------------------------------------------------
// ピクセルシェーダー
// テクスチャがある場合、透明部分（アルファ値が低い箇所）は
// 影を落とさないように「捨てる（discard）」
//
// これにより葉っぱの板ポリの透明部分が影を落とさなくなり、
// 幹の影が葉の影で隠れなくなる。
//--------------------------------------------------------------
void PS(VS_OUT input)
{
    // アルファ値を取得（テクスチャがない場合は1.0 = 不透明）
    float alpha = g_texture.Sample(g_sampler, input.uv).a;

    // アルファ値が0.5未満なら透明とみなして影を落とさない
    if (alpha < 0.5f)
    {
        discard;    // このピクセルを捨てる（深度バッファに書き込まない）
    }
}
